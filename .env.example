# ENEOS スクレイパー（サブ PC）
ENEOS_USERNAME=
ENEOS_PASSWORD=
BUCKET_NAME=

# GCP 認証（各 PC で credentials.json のパスを設定）
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Chrome（サブ PC・任意）
CHROME_BINARY=

# 電力エージェント（ホストごとに異なる Push URL を設定）
UPTIME_KUMA_PUSH_URL=http://192.168.0.54:3100/api/push/YOUR_TOKEN?status=up&msg=OK&ping=

# BigQuery
GCP_PROJECT_ID=
BQ_DATASET_ID=
BQ_POWER_TABLE_ID=
